// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Card {
  id               String   @id @default(cuid())

  // External IDs
  apiId            String   @unique
  riftboundId      String   
  tcgplayerId      String?

  // Basic
  name             String
  cleanName        String?
  collectorNumber  Int

  // Stats
  energy           Int?
  might            Int?
  power            Int?

  // Classification
  type             CardType
  supertype        String?
  rarity           Rarity

  // Text
  richText         String   @db.Text
  plainText        String   @db.Text
  flavorText       String?  @db.Text

  // Media
  imageUrl         String
  artist           String
  accessibility    String

  // Metadata
  orientation      Orientation

  alternateArt     Boolean
  overnumbered     Boolean
  signature        Boolean

  updatedOn        DateTime

  // Relationships
  setId            String
  set              Set @relation(fields: [setId], references: [id])

  domains          CardDomain[]
  tags             CardTag[]
  deckCards        DeckCard[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([name])
  @@index([cleanName])
  @@index([collectorNumber])
}

model Set {

  id          String @id

  label       String

  cards       Card[]
}

model Domain {

  id      String @id @default(cuid())

  name    String @unique

  cards   CardDomain[]
}

model CardDomain {

  cardId      String

  domainId    String

  card         Card @relation(fields: [cardId], references: [id])

  domain       Domain @relation(fields: [domainId], references: [id])

  @@id([cardId, domainId])
}

model Tag {

  id      String @id @default(cuid())

  name    String @unique

  official Boolean @default(false)

  cards   CardTag[]
}

model CardTag {

  cardId      String

  tagId       String

  card         Card @relation(fields: [cardId], references: [id])

  tag          Tag @relation(fields: [tagId], references: [id])

  @@id([cardId, tagId])
}

model User {

  id            String   @id @default(cuid())

  username      String   @unique
  email         String   @unique

  passwordHash  String?

  googleId      String?  @unique

  displayName   String?

  avatar        String?

  role          UserRole @default(USER)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  decks         Deck[]
  hostedMatches Match[]       @relation("HostedMatches")
  matchPlayers  MatchPlayer[]
  matchEvents   MatchEvent[]
}

enum UserRole {
  USER
  ADMIN
}

model Deck {
  id          String   @id @default(cuid())
  name        String
  description String?

  isPublic    Boolean  @default(false)
  format      String   @default("Standard")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     String
  owner        User     @relation(fields: [ownerId], references: [id])

  cards       DeckCard[]
  matchPlayers MatchPlayer[]
}

model DeckCard {

  deckId      String

  cardId      String

  quantity    Int

  deck         Deck @relation(fields: [deckId], references: [id])

  card         Card @relation(fields: [cardId], references: [id])

  @@id([deckId, cardId])
}

model Match {
  id         String       @id @default(cuid())
  hostId     String
  status     MatchStatus  @default(LOBBY)
  visibility MatchVisibility @default(PRIVATE)
  format     String       @default("Standard")
  maxPlayers Int          @default(4)
  joinCode   String       @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  host       User         @relation("HostedMatches", fields: [hostId], references: [id])
  players    MatchPlayer[]
  state      MatchState?
  events     MatchEvent[]

  @@index([joinCode])
  @@index([status])
}

model MatchPlayer {
  matchId     String
  userId      String
  deckId      String?
  seat        Int
  ready       Boolean      @default(false)
  active      Boolean      @default(true)
  eliminated  Boolean      @default(false)
  joinedAt    DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
  deck        Deck?        @relation(fields: [deckId], references: [id], onDelete: SetNull)

  @@id([matchId, userId])
  @@unique([matchId, seat])
  @@index([userId])
}

model MatchState {
  matchId         String   @id
  currentTurn     Int      @default(1)
  currentPhase    String   @default("setup")
  activePlayer    String?
  serializedState String   @default("{}") @db.Text
  updatedAt       DateTime @updatedAt

  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model MatchEvent {
  id        String   @id @default(cuid())
  matchId   String
  playerId  String?
  action    String
  payload   String   @default("{}") @db.Text
  timestamp DateTime @default(now())

  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    User?    @relation(fields: [playerId], references: [id])

  @@index([matchId, timestamp])
}

enum MatchStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
}

enum MatchVisibility {
  PUBLIC
  PRIVATE
}

enum CardType {
  UNIT
  SPELL
  LEGEND
  GEAR
  BATTLEFIELD
  RUNE
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  PROMO
  SHOWCASE
}

enum Orientation {
  PORTRAIT
  LANDSCAPE
}
